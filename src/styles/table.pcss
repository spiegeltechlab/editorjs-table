.tc-wrap {
  --color-background: #f9f9fb;
  --color-border: #e8e8eb;
  --color-text-secondary: #7b7e89;
  --cell-size: 34px;
  --toolbox-icon-size: 18px;
  --toolbox-padding: 6px;
  --toolbox-aiming-field-size: calc(
    var(--toolbox-icon-size) + 2 * var(--toolbox-padding)
  );

  display: grid;
  grid-template-columns: calc(100% - var(--cell-size)) var(--cell-size);
  position: relative;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--toolbox-icon-size);
  /* Bug-fix: https://github.com/editor-js/table/issues/175 */
  z-index: 0;

  .tc-table {
    position: relative;
    width: 100%;
    height: 100%;
    display: table;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 14px;
    border-top: 1px solid var(--color-border);
    line-height: 1.4;
    /* Bug-fix: prose style */
    margin: 0;

    &::after {
      position: absolute;
      content: "";
      width: calc(var(--cell-size));
      height: 100%;
      left: calc(-1 * var(--cell-size));
      top: 0;
    }

    &::before {
      position: absolute;
      content: "";
      width: 100%;
      height: var(--toolbox-aiming-field-size);
      top: calc(-1 * var(--toolbox-aiming-field-size));
      left: 0;
    }

    .tc-row {
      display: table-row;
      border-bottom: 1px solid var(--color-border);
      &.tc-row--selected {
        background: var(--color-background);
      }
    }

    .tc-cell {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: wrap;
      border-right: 1px solid var(--color-border);
      padding: 0;

      &.tc-cell--selected {
        background: var(--color-background);
      }

      &.tc-cell--hidden {
        display: none;
      }

      p {
        margin: 0;
        padding: 0 6px;
        height: auto;
      }
    }
  }

  .tc-add {
    &-column,
    &-row {
      display: flex;
      color: var(--color-text-secondary);
    }
  }

  .tc-add-column {
    display: grid;
    border-top: 1px solid var(--color-border);
    grid-template-columns: var(--cell-size);
    grid-auto-rows: var(--cell-size);
    place-items: center;
    cursor: pointer;
    svg {
      position: sticky;
      top: 0;
    }
    &--disabled {
      visibility: hidden;
    }
  }
  
  .tc-add-row {
    height: var(--cell-size);
    align-items: center;
    position: relative;
    cursor: pointer;
    &--disabled {
      display: none;
    }
    &::before {
      content: "";
      position: absolute;
      right: calc(-1 * var(--cell-size));
      width: var(--cell-size);
      height: 100%;
    }
  }
}